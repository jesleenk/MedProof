pragma language_version 0.23.0;

import CompactStandardLibrary;

// MedProof — private prescription verification demo.
//
// Public ledger data:
//   * random prescription commitments;
//   * patient-encrypted prescription ciphertext;
//   * unlinkable, one-time dispense nullifiers.
//
// Patient identity, diagnosis, doctor name, dosage history, and plaintext
// medicine details never enter public state. Validity bounds are not returned
// to the pharmacist, but Compact's trusted block-time predicates require their
// protocol-level disclosure; this is acknowledged explicitly below. Ciphertext is
// encrypted by the app for the patient's wallet before issuePrescription is
// called. Compact verifies commitments; it does not perform that encryption.

// Small demo scope: one supported medicine and one authorized dispense.
// refillsTotal remains committed so proof explicitly verifies availability.
struct PrescriptionCriteria {
  patientCommit: Bytes<32>;
  drugHash: Bytes<32>;
  validFrom: Uint<64>;
  validUntil: Uint<64>;
  refillsTotal: Uint<8>;
}

struct PrescriptionCredential {
  criteria: PrescriptionCriteria;
  prescriptionNonce: Bytes<32>;
  patientSecret: Bytes<32>;
  patientNonce: Bytes<32>;
  prescriptionPath: MerkleTreePath<20, Bytes<32>>;
}

// Pharmacist UI maps supportedDrugHash to configured medicine name. No doctor,
// diagnosis, patient, dates, or other-medication fields are returned.
struct VerifyResult {
  valid: Boolean;
  drugHash: Bytes<32>;
  refillsRemaining: Uint<8>;
}

export ledger doctorPk: Bytes<32>;

export ledger supportedDrugHash: Bytes<32>;

export ledger issuedPrescriptions: HistoricMerkleTree<20, Bytes<32>>;

export ledger encryptedPrescriptions: Map<Bytes<32>, Bytes<256>>;

export ledger usedDispenses: Set<Bytes<32>>;

constructor(doctorSecret: Bytes<32>, drugHash: Bytes<32>) {
  doctorPk = disclose(doctorKey(doctorSecret));
  supportedDrugHash = disclose(drugHash);
}

// Private inputs supplied locally by wallet/provider implementations.
witness doctorSecretKey(): Bytes<32>;

witness prescriptionCredential(): PrescriptionCredential;

circuit doctorKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "medproof:doctor"), secret]);
}

circuit patientCommitment(secret: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>([pad(32, "medproof:patient"), secret], nonce);
}

circuit prescriptionId(criteria: PrescriptionCriteria, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<PrescriptionCriteria>(criteria, nonce);
}

// Nullifier uses patient-only secret as commitment opening. Doctor knows the
// prescription id but cannot derive or link this dispense marker.
circuit dispenseNullifier(id: Bytes<32>, patientSecret: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>([pad(32, "medproof:dispense"), id], patientSecret);
}

circuit credentialMatches(id: Bytes<32>, credential: PrescriptionCredential): Boolean {
  const correctId = prescriptionId(credential.criteria, credential.prescriptionNonce) == id;
  const correctPatient =
          patientCommitment(credential.patientSecret, credential.patientNonce) ==
          credential.criteria.patientCommit;
  const correctDrug = credential.criteria.drugHash == supportedDrugHash;
  const demoRefillPolicy = credential.criteria.refillsTotal == 1;

  return correctId && correctPatient && correctDrug && demoRefillPolicy;
}

circuit currentlyValid(criteria: PrescriptionCriteria): Boolean {
  return blockTimeGte(disclose(criteria.validFrom)) && blockTimeLte(disclose(criteria.validUntil));
}

circuit authorizedDoctor(): Boolean {
  return doctorKey(doctorSecretKey()) == doctorPk;
}

// Doctor issues commitment plus patient-encrypted payload. Criteria arguments
// stay private; only random commitment id and ciphertext reach public ledger.
export circuit issuePrescription(
                 patientCommit: Bytes<32>,
                 validFrom: Uint<64>,
                 validUntil: Uint<64>,
                 encryptedDetails: Bytes<256>,
                 prescriptionNonce: Bytes<32>
                 ): Bytes<32> {
  assert(disclose(authorizedDoctor()), "issuePrescription: not authorized doctor");
  assert(disclose(validUntil > validFrom), "issuePrescription: bad validity window");

  const criteria =
          PrescriptionCriteria { patientCommit: patientCommit,
                                 drugHash: supportedDrugHash,
                                 validFrom: validFrom,
                                 validUntil: validUntil,
                                 refillsTotal: 1 };
  const id = prescriptionId(criteria, prescriptionNonce);

  assert(!encryptedPrescriptions.member(id), "issuePrescription: duplicate id");
  issuedPrescriptions.insert(id);
  encryptedPrescriptions.insert(id, disclose(encryptedDetails));

  return id;
}

// Patient wallet generates proof. Caller supplies medicine requested by
// pharmacist; contract proves committed medicine matches without returning
// patient, dates, doctor, diagnosis, or ciphertext plaintext.
export circuit proveValidPrescription(requestedDrugHash: Bytes<32>): VerifyResult {
  const publicRequestedDrugHash = disclose(requestedDrugHash);
  const credential = prescriptionCredential();
  const id = prescriptionId(credential.criteria, credential.prescriptionNonce);
  const root = merkleTreePathRoot<20, Bytes<32>>(credential.prescriptionPath);
  // Historic root is public; path and leaf remain private.
  const issued = issuedPrescriptions.checkRoot(disclose(root));
  const correctLeaf = credential.prescriptionPath.leaf == id;
  const nullifier = dispenseNullifier(id, credential.patientSecret);
  const available = !usedDispenses.member(nullifier);
  // Compute effectful checks unconditionally. Short-circuiting private booleans
  // around block-time or ledger operations creates unintended control leakage.
  const matchesCredential = credentialMatches(id, credential);
  const matchesDrug = publicRequestedDrugHash == supportedDrugHash;
  const inWindow = currentlyValid(credential.criteria);
  const valid = issued && correctLeaf && matchesCredential && matchesDrug && inWindow && available;

  if (disclose(valid)) {
    return VerifyResult { valid: true, drugHash: supportedDrugHash, refillsRemaining: 1 };
  } else {
    return VerifyResult { valid: false, drugHash: publicRequestedDrugHash, refillsRemaining: 0 };
  }
}

// Patient authorizes dispense from own device by supplying private credential.
// Contract re-checks every condition, then records one unlinkable nullifier.
// Replays and double fills fail because same nullifier cannot be inserted twice.
export circuit dispense(requestedDrugHash: Bytes<32>): Uint<8> {
  const publicRequestedDrugHash = disclose(requestedDrugHash);
  const credential = prescriptionCredential();
  const id = prescriptionId(credential.criteria, credential.prescriptionNonce);
  const root = merkleTreePathRoot<20, Bytes<32>>(credential.prescriptionPath);
  // Historic root is public; path and leaf remain private.
  const issued = issuedPrescriptions.checkRoot(disclose(root));
  const correctLeaf = credential.prescriptionPath.leaf == id;

  assert(disclose(issued && correctLeaf), "dispense: unknown prescription");
  assert(disclose(credentialMatches(id, credential)), "dispense: invalid credential");
  assert(publicRequestedDrugHash == supportedDrugHash, "dispense: wrong medicine");
  assert(disclose(currentlyValid(credential.criteria)), "dispense: outside valid window");

  const nullifier = dispenseNullifier(id, credential.patientSecret);
  assert(!usedDispenses.member(nullifier), "dispense: already filled");
  usedDispenses.insert(nullifier);

  // Explicit on-chain refill state transition: remaining 1 -> 0.
  return 0;
}
